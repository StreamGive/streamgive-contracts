#!/usr/bin/env bash
# Git pre-commit hook for streamgive-contracts
# Checks formatting and clippy on changed workspace crates.
#
# To install:
#   git config core.hooksPath scripts/hooks
#   chmod +x scripts/hooks/pre-commit
# or copy/symlink to .git/hooks/pre-commit

set -euo pipefail

echo "Running pre-commit checks..."

# Identify changed files that are staged for commit
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Check if any Rust files or Cargo manifests in contracts are staged
CHECK_VAULT=false
CHECK_REGISTRY=false
CHECK_ROOT=false

for file in $STAGED_FILES; do
    case "$file" in
        contracts/donation-vault/*)
            CHECK_VAULT=true
            ;;
        contracts/ngo-registry/*)
            CHECK_REGISTRY=true
            ;;
        Cargo.toml|Cargo.lock)
            CHECK_ROOT=true
            ;;
    esac
done

# If root manifests changed, check the whole workspace
if [ "$CHECK_ROOT" = true ]; then
    CHECK_VAULT=true
    CHECK_REGISTRY=true
fi

# Only proceed if there are changes in contracts
if [ "$CHECK_VAULT" = false ] && [ "$CHECK_REGISTRY" = false ]; then
    echo "No contract crate changes detected. Skipping Rust formatting and lint checks."
    exit 0
fi

# 1. Format check
echo "Checking code formatting with cargo fmt..."
cargo fmt --all -- --check

# 2. Clippy check on changed crates
if [ "$CHECK_VAULT" = true ] && [ "$CHECK_REGISTRY" = true ]; then
    echo "Running cargo clippy on workspace..."
    cargo clippy --workspace --all-targets -- -D warnings
elif [ "$CHECK_VAULT" = true ]; then
    echo "Running cargo clippy on donation-vault..."
    cargo clippy -p donation-vault --all-targets -- -D warnings
elif [ "$CHECK_REGISTRY" = true ]; then
    echo "Running cargo clippy on ngo-registry..."
    cargo clippy -p ngo-registry --all-targets -- -D warnings
fi

echo "Pre-commit checks passed successfully!"
